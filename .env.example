# ============================================================
# Vidyaaraa — Environment Variables Example
# Copy this file to .env.local and fill in the values
# ============================================================

# Supabase (https://supabase.com)
# Public Anon Key: safe for browser client requests (reads public data & auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (SERVER-SIDE ONLY - NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider Keys (for Vidyaaraa AI / Doubt Solver)
META_API_KEY=your_meta_api_key_here
LLM_API_KEY=your_meta_api_key_here
META_MODEL=muse-spark-1.3

# Optional AI Fallbacks
GROQ_API_KEY=
GEMINI_API_KEY=
